// mou7asib — Prisma schema
//
// D2 domain: a tenant uploads a document (phone photo, or a PDF as of the
// dashboard extension), a Postgres-mediated queue (ExtractionJob) hands it
// to the Python worker in apps/ai, which extracts fields via the D1 harness
// and writes ExtractionAttempt + ExtractedField rows back. See
// docs/decision-log.md D2/D-13 and the D2 dashboard extension plan for the
// full rationale.
//
// Every new-in-D2 model gets an explicit @map("snake_case") on every field,
// not just @@map on the table — apps/ai's worker writes to these tables via
// raw psycopg SQL, not Prisma, so an unquoted camelCase identifier would
// silently fold to lowercase under Postgres's identifier rules. This is a
// deliberate deviation from Tenant's original convention (table-only @@map),
// not an inconsistency: Tenant predates having a second, non-Prisma writer.
//
// CLAUDE.md rules this schema is built to honour from the start (ADR 0006:
// "may not skip tenantId, Decimal(19,4), or the upload allowlist"):
//   - §2 rule 1 / §6 — money and TVA-rate amounts are Decimal(19,4), never Float.
//   - §8.1           — every tenant-owned table has a non-nullable, indexed tenantId.
//   - §5.7           — timestamps stored in UTC (timestamptz).
//   - §7.2           — bounding box / page reference stored per extracted field,
//                      content hash stored per document for duplicate detection.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  documents          Document[]
  extractionJobs     ExtractionJob[]
  extractionAttempts ExtractionAttempt[]
  extractedFields    ExtractedField[]

  @@map("tenants")
}

enum DocumentStatus {
  uploaded
  queued
  processing
  extracted
  failed

  @@map("document_status")
}

model Document {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  /// D1's document_id_for logic (sha256[:16]) — duplicate detection, CLAUDE.md §7.2.
  contentHash       String  @map("content_hash")
  originalFilename  String  @map("original_filename")
  /// Detected via magic bytes (CLAUDE.md §8.4) — never the client-declared MIME type.
  mimeType          String  @map("mime_type")
  byteSize          Int     @map("byte_size")
  /// Relative to the uploads/ root, outside apps/web's public/static tree.
  storagePath       String  @map("storage_path")
  /// Canonical frame that every ExtractedField.boundingBox is normalized against —
  /// the post-EXIF-normalization, post-strip stored file, not any model-internal
  /// resize. Nullable: for a PDF upload these are unknown at upload time (no EXIF
  /// concept applies, no image to measure) and are filled in by the worker once
  /// it rasterizes previewImagePath.
  storedImageWidth  Int?    @map("stored_image_width")
  storedImageHeight Int?    @map("stored_image_height")
  /// Worker-rasterized first-page PNG for PDFs (PyMuPDF, proven — sharp's PDF
  /// support depends on an unverified libvips/poppler build, the same trap as
  /// the HEIC gotcha). Null for image uploads, where storagePath IS the
  /// preview, and null for a PDF whose rasterization hasn't run yet or failed
  /// (a corrupt/encrypted PDF must not abort extraction).
  previewImagePath  String? @map("preview_image_path")

  status DocumentStatus @default(uploaded)

  /// The winning attempt whose fields the review screen renders. A reprocess
  /// creates a new attempt and repoints this rather than deleting history.
  currentAttemptId String?            @unique @map("current_attempt_id") @db.Uuid
  currentAttempt   ExtractionAttempt? @relation("DocumentCurrentAttempt", fields: [currentAttemptId], references: [id])

  jobs     ExtractionJob[]
  attempts ExtractionAttempt[] @relation("DocumentAttempts")
  fields   ExtractedField[]

  uploadedAt DateTime  @default(now()) @map("uploaded_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// Soft-delete only — CLAUDE.md §9 wants this for user-facing (non-ledger)
  /// records. The underlying file(s) are hard-deleted from disk regardless
  /// (the most sensitive artifact, and no legal retention obligation exists
  /// yet to block that); this column keeps metadata + an audit trail that a
  /// deletion happened. Every query against Document must filter
  /// deletedAt: null — see apps/web/lib/documents.ts.
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([tenantId, contentHash])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("documents")
}

enum JobStatus {
  queued
  processing
  succeeded
  failed

  @@map("job_status")
}

/// Queue mechanics, kept separate from Document's business-facing status so
/// the two don't get tangled and so this shape survives future job types
/// unchanged. The worker claims rows with SELECT ... FOR UPDATE SKIP LOCKED
/// (ADR 0002's own recommended queue mechanism) — no Redis, no broker.
model ExtractionJob {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id])

  status       JobStatus @default(queued)
  attemptCount Int       @default(0) @map("attempt_count")
  /// Set when a worker claims the row; startup crash-recovery requeues jobs
  /// stuck `processing` past a generous ceiling (~20 min, past the measured
  /// 500-600s worst case in D1) — simple recovery for a single worker process.
  lockedAt     DateTime? @map("locked_at") @db.Timestamptz(6)
  lockedBy     String?   @map("locked_by")
  lastError    String?   @map("last_error")

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  startedAt  DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt DateTime? @map("finished_at") @db.Timestamptz(6)

  attempts ExtractionAttempt[]

  @@index([tenantId])
  @@index([documentId])
  @@index([status])
  @@map("extraction_jobs")
}

enum ExtractionPath {
  text_layer
  ocr

  @@map("extraction_path")
}

/// The CLAUDE.md §7.2 cost/audit tuple (ADR 0005's schema), persisted so the
/// web tier can query/render it — D1 kept this in a JSONL file, which was
/// fine for a CLI-only spike but D2 is not a throwaway.
model ExtractionAttempt {
  id       String        @id @default(uuid(7)) @db.Uuid
  jobId    String        @map("job_id") @db.Uuid
  job      ExtractionJob @relation(fields: [jobId], references: [id])
  tenantId String        @map("tenant_id") @db.Uuid
  tenant   Tenant        @relation(fields: [tenantId], references: [id])

  documentId String   @map("document_id") @db.Uuid
  document   Document @relation("DocumentAttempts", fields: [documentId], references: [id])

  attemptNumber Int            @map("attempt_number")
  model         String
  promptVersion String         @map("prompt_version")
  path          ExtractionPath

  /// Whether this attempt produced a validated extraction (extraction != None
  /// in D1's terms) — a failed attempt still gets a row, per CLAUDE.md §7.2.
  success        Boolean
  rawResponse    String   @map("raw_response")
  inputTokens    Int      @map("input_tokens")
  outputTokens   Int      @map("output_tokens")
  /// Always 0 for local Ollama calls — recorded explicitly, never omitted.
  costMinorUnits Int      @map("cost_minor_units")
  computeMs      Int      @map("compute_ms")
  latencyMs      Int      @map("latency_ms")
  /// HT + TVA == TTC, reusing D1's scoring.py check_arithmetic — computed
  /// independently of the model's own confidence (CLAUDE.md §7.2). Null when
  /// there's no successful extraction to check.
  arithmeticOk   Boolean? @map("arithmetic_ok")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  currentForDocument Document?        @relation("DocumentCurrentAttempt")
  extractedFields    ExtractedField[]

  @@index([tenantId])
  @@index([documentId])
  @@map("extraction_attempts")
}

enum ExtractedFieldType {
  string
  date
  decimal

  @@map("extracted_field_type")
}

/// One row per independently-drillable field — normalized, not a JSON blob,
/// per CLAUDE.md §9's indexing rule and because a future review queue needs
/// to filter/query across fields ("every document with total_ttc confidence
/// < 0.7"), which a blob forecloses. Only fields the model actually returned
/// a non-null value for get a row; the review UI treats a missing row as
/// "not extracted," which is what makes "flagged rather than guessed" visible.
model ExtractedField {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [id])

  attemptId String            @map("attempt_id") @db.Uuid
  attempt   ExtractionAttempt @relation(fields: [attemptId], references: [id])

  /// Matches InvoiceExtraction's Python attribute names literally, e.g.
  /// "invoice_number", "total_ttc", "rate", "base_ht".
  fieldName    String             @map("field_name")
  /// groupName="tva_lines", groupIndex=0,1,2... for repeated TVA-rate groups.
  /// Both null for scalar fields.
  groupName    String?            @map("group_name")
  groupIndex   Int?               @map("group_index")
  fieldType    ExtractedFieldType @map("field_type")
  valueText    String?            @map("value_text")
  /// CLAUDE.md §2 rule 1 — money/rate amounts are Decimal(19,4), never Float.
  /// Populated only for amount/rate fields; null for string/date fields.
  valueDecimal Decimal?           @map("value_decimal") @db.Decimal(19, 4)
  /// 0-1. Not money, so Float is fine here (CLAUDE.md rule 1 restricts money
  /// specifically). Computed, never the model's own self-reported confidence
  /// — see apps/ai's grounding module for how this is derived.
  confidence   Float
  pageNumber   Int                @default(1) @map("page_number")
  /// {x, y, width, height} as 0-1 fractions of Document.storedImageWidth/Height.
  /// The one deliberate exception to normalizing everything into columns: a
  /// bounding box is never filtered or sorted on, only read out whole for
  /// rendering. Validate its shape with Zod before trusting it client-side —
  /// a separate process (the worker) wrote this, not Prisma itself.
  boundingBox  Json?              @map("bounding_box")

  /// User corrections, additive — valueText/valueDecimal above are the
  /// model's original output and are NEVER overwritten in place, even when a
  /// user edits the field. This preserves the "was the model right on this
  /// field" signal D1/S1a's accuracy measurement depends on. Display/logic
  /// rule everywhere: override ?? original. correctedAt IS NOT NULL is the
  /// "has this been corrected" signal (no separate boolean to keep in sync).
  /// No correctedBy — no real user identity yet (single demo tenant, no
  /// auth); add at W2 rather than stub it now.
  overrideValueText    String?   @map("override_value_text")
  overrideValueDecimal Decimal?  @map("override_value_decimal") @db.Decimal(19, 4)
  correctedAt          DateTime? @map("corrected_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId])
  @@index([documentId])
  @@index([attemptId])
  @@map("extracted_fields")
}
